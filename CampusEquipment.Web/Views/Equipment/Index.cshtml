@model IEnumerable<CampusEquipment.Core.DTOs.EquipmentDto>
@using CampusEquipment.Core.DTOs

@{
    ViewData["Title"] = "Equipment";
    var categories = new[] { "Computer", "Laptop", "Projector", "Printer", "Network", "Other" };
    var statuses = new[] { "Available", "Assigned", "UnderMaintenance", "Retired" };
    var selectedDepartmentId = ViewBag.DepartmentId as int?;
}

<h2 class="mb-3">Equipment</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="text" name="search" value="@ViewBag.Search"
               class="form-control" placeholder="Search by asset code, name, brand" />
    </div>
    <div class="col-md-2">
        <select name="category" class="form-select">
            <option value="">-- Category --</option>
            @foreach (var c in categories)
            {
                <option value="@c" selected="@(ViewBag.Category == c)">@c</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">-- Status --</option>
            @foreach (var s in statuses)
            {
                <option value="@s" selected="@(ViewBag.Status == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="departmentId" class="form-select" asp-items="ViewBag.Departments">
            <option value="">-- Department --</option>
        </select>
    </div>
    <div class="col-md-2 d-flex gap-1">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-success">+ New Equipment</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Asset Code</th>
            <th>Name</th>
            <th>Category</th>
            <th>Brand</th>
            <th>Model</th>
            <th>Status</th>
            <th>Department</th>
            <th style="width: 240px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No equipment found.</td>
            </tr>
        }
        else
        {
            @foreach (var e in Model)
            {
                <tr>
                    <td><strong>@e.AssetCode</strong></td>
                    <td>@e.Name</td>
                    <td>@e.Category</td>
                    <td>@e.Brand</td>
                    <td>@e.Model</td>
                    <td>
                        @{
                            var badgeClass = e.Status switch
                            {
                                "Available" => "bg-success",
                                "Assigned" => "bg-primary",
                                "UnderMaintenance" => "bg-warning text-dark",
                                "Retired" => "bg-secondary",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@e.Status</span>
                    </td>
                    <td>@e.DepartmentName</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@e.EquipmentId" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@e.EquipmentId" class="btn btn-sm btn-warning">Edit</a>

                        @if (e.Status != "Retired")
                        {
                            <form asp-action="Retire" asp-route-id="@e.EquipmentId" method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Retire @e.AssetCode?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-secondary">Retire</button>
                            </form>
                        }

                        <form asp-action="Delete" asp-route-id="@e.EquipmentId" method="post"
                              class="d-inline"
                              onsubmit="return confirm('Permanently delete @e.AssetCode? This cannot be undone.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>